# Copie para .env e preencha. O .env não vai para o Git.
# O settings.py lê este arquivo automaticamente com python-dotenv.

# Use True só em desenvolvimento.
DJANGO_DEBUG=True

# Sem esta variável, o desenvolvimento usa uma chave temporária, e as sessões caem ao
# reiniciar o servidor. Para gerar um valor:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hosts aceitos, separados por vírgula. Com DEBUG=True, localhost já é aceito.
DJANGO_ALLOWED_HOSTS=

# Remetente dos e-mails (em desenvolvimento, eles aparecem no terminal).
DJANGO_DEFAULT_FROM_EMAIL=nao-responda@localhost

# PostgreSQL (veja o README para criar o usuário e o banco).
POSTGRES_DB=plataforma_libras
POSTGRES_USER=libras_owner
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
